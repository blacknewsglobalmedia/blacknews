rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // BLACKNEWS — reglas endurecidas (prioridad 1)
    //
    // Antes: "allow write: if true" → cualquier visitante anónimo podía
    // sobrescribir portada, teletipo, categorías y artículos.
    //
    // Ahora: lecturas públicas (sitio informativo), escrituras SOLO de la
    // sesión de Google verificada de blacknewsglobalmedia@gmail.com.
    //
    // Para sumar redactores más adelante, o bien añade su correo a
    // isEditor() o —mejor— usa custom claims de Firebase Auth
    // (request.auth.token.role == 'REDACTOR'), que no se pueden falsificar
    // desde el cliente.
    // -----------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Único propietario/administrador del proyecto
    function isOwner() {
      return isVerifiedEmail()
        && request.auth.token.email == 'blacknewsglobalmedia@gmail.com';
    }

    // Quién puede publicar/editar contenido editorial
    function isEditor() {
      return isOwner();
    }

    // Denegado por defecto (Firestore ya es deny-by-default; queda explícito)
    match /{document=**} {
      allow read, write: if false;
    }

    // Comprobación de conexión del cliente: solo lectura
    match /test/{document=**} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Artículos: lectura pública para todos los lectores de BLACKNEWS
    match /reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Teletipo / última hora (colección flash_news)
    match /flash_news/{flashId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Configuración: settings/frontpage_layout, settings/flash_news,
    // settings/categories
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Perfiles y permisos del equipo (contiene correos → no es público)
    match /users/{userId} {
      allow read: if isEditor();
      allow create, update, delete: if isOwner();
    }

    // -----------------------------------------------------------------
    // Publicidad autogestionada (colección ads)
    //
    // Lectura pública: los visitantes ven los banners y el panel de
    // aprobaciones ve las solicitudes (sin esto, un anuncio enviado desde
    // el navegador del anunciante jamás llegaría al admin).
    //
    // Creación: cualquier cuenta de Google verificada —el modal exige
    // login— y SOLO con estado PENDIENTE_PAGO y con el correo del
    // solicitante igual al de la sesión (no se puede presentar en nombre
    // de otro).
    //
    // Edición:
    //  - el propietario aprueba/rechaza/pausa/edita (flujo AdsManager);
    //  - el anunciante solo puede transicionar su propia campaña de
    //    PENDIENTE_PAGO a PENDIENTE_APROBACION al volver de PayPal
    //    (comprobante "PayPal order …"), sin tocar el resto de estados.
    //    Aunque se falseara, jamás llega a ACTIVE sin aprobación del
    //    propietario, que es quien verifica el cobro.
    //
    // Borrado: solo propietario.
    // -----------------------------------------------------------------
    match /ads/{campaignId} {
      allow read: if true;
      allow create: if isVerifiedEmail()
        && request.resource.data.applicantEmail == request.auth.token.email
        && request.resource.data.status == 'PENDIENTE_PAGO';
      allow update: if isOwner()
        || (isVerifiedEmail()
            && resource.data.applicantEmail == request.auth.token.email
            && request.resource.data.applicantEmail == request.auth.token.email
            && ((resource.data.status == request.resource.data.status
                 && resource.data.status == 'PENDIENTE_PAGO')
                || (resource.data.status == 'PENDIENTE_PAGO'
                    && request.resource.data.status == 'PENDIENTE_APROBACION'
                    && request.resource.data.paymentReceiptUrl
                         is string
                    && request.resource.data.paymentReceiptUrl
                         matches 'PayPal order .*')));
      allow delete: if isOwner();
    }
  }
}
