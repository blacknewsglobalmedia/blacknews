rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // BLACKNEWS — reglas endurecidas (prioridad 1)
    //
    // Antes: "allow write: if true" → cualquier visitante anónimo podía
    // sobrescribir portada, teletipo, categorías y artículos.
    //
    // Ahora: lecturas públicas (sitio informativo), escrituras SOLO de la
    // sesión de Google verificada de blacknewsglobalmedia@gmail.com.
    //
    // Para sumar redactores más adelante, o bien añade su correo a
    // isEditor() o —mejor— usa custom claims de Firebase Auth
    // (request.auth.token.role == 'REDACTOR'), que no se pueden falsificar
    // desde el cliente.
    // -----------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Único propietario/administrador del proyecto
    function isOwner() {
      return isVerifiedEmail()
        && request.auth.token.email == 'blacknewsglobalmedia@gmail.com';
    }

    // Quién puede publicar/editar contenido editorial
    function isEditor() {
      return isOwner();
    }

    // Denegado por defecto (Firestore ya es deny-by-default; queda explícito)
    match /{document=**} {
      allow read, write: if false;
    }

    // Comprobación de conexión del cliente: solo lectura
    match /test/{document=**} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Artículos: lectura pública para todos los lectores de BLACKNEWS
    match /reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Teletipo / última hora (colección flash_news)
    match /flash_news/{flashId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Configuración: settings/frontpage_layout, settings/flash_news,
    // settings/categories
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Perfiles y permisos del equipo (contiene correos → no es público)
    match /users/{userId} {
      allow read: if isEditor();
      allow create, update, delete: if isOwner();
    }

    // -----------------------------------------------------------------
    // Publicidad autogestionada (colección ads)
    //
    // Lectura pública: los visitantes ven los banners y el panel de
    // aprobaciones ve las solicitudes (sin esto, un anuncio enviado desde
    // el navegador del anunciante jamás llegaría al admin).
    //
    // Creación: cualquier cuenta de Google verificada —el modal exige
    // login— y SOLO con estado PENDIENTE_PAGO y con el correo del
    // solicitante igual al de la sesión (no se puede presentar en nombre
    // de otro).
    //
    // Edición:
    //  - el propietario aprueba/rechaza/pausa/edita (flujo AdsManager);
    //  - el anunciante solo puede transicionar su propia campaña de
    //    PENDIENTE_PAGO a PENDIENTE_APROBACION al volver de PayPal
    //    (comprobante "PayPal order …"), sin tocar el resto de estados.
    //    Aunque se falseara, jamás llega a ACTIVE sin aprobación del
    //    propietario, que es quien verifica el cobro.
    //
    // Borrado: solo propietario.
    // -----------------------------------------------------------------
    match /ads/{campaignId} {
      allow read: if true;
      allow create: if isVerifiedEmail()
        && request.resource.data.applicantEmail == request.auth.token.email
        && request.resource.data.status == 'PENDIENTE_PAGO';
      // El anunciante solo puede conservar su solicitud en PENDIENTE_PAGO
      // o pasarla a PENDIENTE_APROBACION con comprobante PayPal, sin tocar
      // el resto de estados (aprueba/rechaza el propietario).
      allow update: if isOwner()
        || (isVerifiedEmail()
            && resource.data.applicantEmail == request.auth.token.email
            && request.resource.data.applicantEmail == request.auth.token.email
            && resource.data.status == 'PENDIENTE_PAGO'
            && request.resource.data.status == 'PENDIENTE_PAGO')
        || (isVerifiedEmail()
            && resource.data.applicantEmail == request.auth.token.email
            && request.resource.data.applicantEmail == request.auth.token.email
            && resource.data.status == 'PENDIENTE_PAGO'
            && request.resource.data.status == 'PENDIENTE_APROBACION'
            && request.resource.data.paymentReceiptUrl is string
            && request.resource.data.paymentReceiptUrl.startsWith('PayPal order '));
      allow delete: if isOwner();
    }

    // -----------------------------------------------------------------
    // Comentarios y reacciones públicos de los posts
    //
    // Colecciones `comments` y `reactions` (lectura pública: cualquier
    // visitante ve la conversación; ver src/utils/comments.ts).
    //
    // Escritura solo con Google verificada y SIEMPRE a nombre propio:
    //  - comments: el correo del autor debe ser el de la sesión, texto de
    //    1 a 600 caracteres; el autor borra (o edita) lo suyo y el
    //    propietario puede moderar cualquier comentario.
    //  - reactions: un "Me gusta" por (post, correo) — el id del documento
    //    es `${reportId}_${correo}` — creándolo o borrándolo para alternar.
    //
    // La cuota diaria de comentarios por plan se controla en el cliente
    // (mismo patrón que las lecturas gratuitas: ver utils/commentMeter).
    // -----------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isVerifiedEmail()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.reportId is string
        && request.resource.data.reportId.size() > 0
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.avatarInitials is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600
        && request.resource.data.createdAt is number;
      allow update: if isVerifiedEmail()
        && resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.reportId == resource.data.reportId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.avatarInitials == resource.data.avatarInitials
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600;
      allow delete: if isOwner()
        || (isVerifiedEmail()
            && resource.data.authorEmail == request.auth.token.email);
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if isVerifiedEmail()
        && reactionId == request.resource.data.reportId + '_'
             + request.auth.token.email
        && request.resource.data.reportId is string
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.kind == 'like'
        && request.resource.data.createdAt is number;
      allow delete: if isOwner()
        || (isVerifiedEmail()
            && resource.data.userEmail == request.auth.token.email);
    }
  }
}
