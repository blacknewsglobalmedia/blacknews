{
  "$schema": "node_modules/wrangler/config-schema.json",
  // BLACKNEWS — Cloudflare Worker: sirve el frontend (dist/) + API de imágenes.
  // Secretos NO se guardan aquí: se envían con
  //   npx wrangler secret put CLOUDINARY_API_KEY
  //   npx wrangler secret put CLOUDINARY_API_SECRET
  //   npx wrangler secret put PAYPAL_CLIENT_ID     (appId de PayPal, sandbox o live)
  //   npx wrangler secret put PAYPAL_SECRET        (secret de PayPal)
  //   npx wrangler secret put OPENROUTER_API_KEY   (clave de OpenRouter para la IA editorial)
  //   npx wrangler secret put TAVILY_API_KEY       (búsqueda web de la redacción; opcional)
  // En local (wrangler dev) van en .dev.vars (gitignored).
  "name": "blacknews",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // El Worker atiende /api/* y delega el resto en los assets estáticos
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // La única credencial "pública" de Cloudinary (es el identificador del entorno)
    "CLOUDINARY_CLOUD_NAME": "jxryjgjq",
    // Entorno de PayPal: 'sandbox' para pruebas, 'live' para cobrar de verdad.
    // Este archivo manda sobre la variable del dashboard al desplegar con
    // wrangler: si aquí dice 'sandbox', las credenciales live se mandan al
    // endpoint sandbox → OAuth 401 y planIds vacíos.
    "PAYPAL_MODE": "live",
    // Cadena de modelos de la redacción asistida (POST /api/ai/generate).
    // Se admiten varios modelos separados por comas para concatenar fallbacks:
    // si el primero está saturado (429) o en mantenimiento, pasa automáticamente
    // al siguiente sin interrumpir la generación del usuario.
    "OPENROUTER_MODEL": "nvidia/nemotron-3-super-120b-a12b:free, meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free, qwen/qwen-2.5-72b-instruct:free, google/gemma-2-9b-it:free"
  },
  // Accesos de suscripción concedidos (solo escribe el Worker tras cobrar en PayPal)
  "kv_namespaces": [
    {
      "binding": "PAYPAL_KV",
      "id": "75573049d6b3424d96c70c1f9cd077a5"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
  // ALMACENAMIENTO R2 (opcional, sin access keys: se usa el binding del bucket)
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "news-media-images" }]
}
